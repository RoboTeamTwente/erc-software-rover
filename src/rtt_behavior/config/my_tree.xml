<root BTCPP_format="4" main_tree_to_execute="MainCollectTask">

  <BehaviorTree ID="MainCollectTask">
    <ReactiveSequence>
      
      <IsEmpty entity="container"/>

      <Sequence>
        <Fallback>
          <Sequence>
            <Fallback>
              <IsNear entity="rover" target="object" distance="15"/>
              <Approach theta="0.0"/>
            </Fallback>

            <Fallback>
              <Contains entity="container" content="object"/>
              <Sequence>
                <Fallback>
                  <Contains entity="gripper" content="object"/>
                  <SubTree ID="GripTask"/> 
                </Fallback>
                
                <Fallback>
                  <Contains entity="container" content="gripper"/>
                  <Sequence>
                    <Fallback>
                      <IsContainerOpen/>
                      <OpenContainer/>
                    </Fallback>
                    <Approach theta="1.57"/>
                  </Sequence>
                </Fallback>
              </Sequence>
            </Fallback>
          </Sequence>

          <Sequence>
            <Fallback>
              <IsContainerClosed/>
              <Sequence>
                <Fallback>
                  <Inverter>
                    <Contains entity="container" content="gripper"/>
                  </Inverter>
                  <Sequence>
                    <Fallback>
                      <IsGripperOpen/>
                      <OpenGripper/>
                    </Fallback>
                    <Approach theta="3.14"/>
                  </Sequence>
                </Fallback>
                <CloseContainer/>
              </Sequence>
            </Fallback>
          </Sequence>
        </Fallback>
      </Sequence>

      <Fallback>
        <IsArmResting/>
        <RestArm/>
      </Fallback>

    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="GripTask">
    <Sequence>
      <Fallback>
        <IsNear entity="gripper" target="object" distance="10"/> 
        <Sequence>
          <Fallback>
            <IsGripperOpen/>
            <OpenGripper/>
          </Fallback>
          <Approach theta="0.78"/> 
        </Sequence>
      </Fallback>

      <Fallback>
        <IsGripperClosed/>
        <CloseGripper/>
      </Fallback>
      <ExtractWithGripper distance="5"/>
    </Sequence>
  </BehaviorTree>

</root>